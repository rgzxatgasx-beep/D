-- ฟังก์ชันสำหรับสร้างข้อความแสดงสถานะพร้อมสี (RichText)
local function GetStatusText(state)
   if state then
      return '<font color="#00FF00">[ เปิดใช้งาน ]</font>'
   else
      return '<font color="#FF0000">[ ปิดใช้งาน ]</font>'
   end
end

