MainTab:CreateSection("สถานะระบบหลัก")

local FarmStatus = MainTab:CreateParagraph({
   Title = "สถานะ ฟาร์มอัตโนมัติ",
   Content = GetStatusText(false)
})

local ShootStatus = MainTab:CreateParagraph({
   Title = "สถานะ ยิงซอมบี้อัตโนมัติ",
   Content = GetStatusText(false)
})

MainTab:CreateSection("ควบคุมระบบฟาร์ม")

MainTab:CreateToggle({
   Name = "เปิดระบบฟาร์มอัตโนมัติ (Auto Farm)",
   CurrentValue = false,
   Flag = "AutoFarmToggle",
   Callback = function(Value)
      AutoFarm = Value
      FarmStatus:Set({Title = "สถานะ ฟาร์มอัตโนมัติ", Content = GetStatusText(Value)})
      
      task.spawn(function()
         while AutoFarm do
            task.wait(0.5)
            print("กำลังฟาร์มอัตโนมัติ...")
         end
      end)
