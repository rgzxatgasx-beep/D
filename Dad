-- 4. TAB: VISUAL (ESP มองทะลุ)
-- ==========================================

VisualTab:CreateSection("ตั้งค่าการมองทะลุ")

local ItemESPStatus = VisualTab:CreateParagraph({
   Title = "สถานะ มองทะลุสิ่งของ",
   Content = GetStatusText(false)
})

VisualTab:CreateToggle({
   Name = "เปิดการมองทะลุกำแพง (ESP Items/Objects)",
   CurrentValue = false,
   Flag = "ESPToggle",
   Callback = function(Value)
      ESPEnabled = Value
      ItemESPStatus:Set({Title = "สถานะ มองทะลุสิ่งของ", Content = GetStatusText(Value)})
   end,
})

VisualTab:CreateColorPicker({
    Name = "ปรับสี Highlight สิ่งของ",
    Color = Color3.fromRGB(255, 0, 0),
    Flag = "ESPColorPicker",
    Callback = function(Value)
        ESPColor = Value
    end
})

VisualTab:CreateSection("ระบบมองเห็นผู้เล่นอื่น")

local PlayerESPStatusDisplay = VisualTab:CreateParagraph({
   Title = "สถานะ มองเห็นผู้เล่นอื่น",
   Content = GetStatusText(false)
})

VisualTab:CreateToggle({
   Name = "มองเห็นผู้เล่นอื่น (Player ESP)",
   CurrentValue = false,
   Flag = "PlayerESPToggle",
   Callback = function(Value)
      PlayerESPEnabled = Value
      PlayerESPStatusDisplay:Set({Title = "สถานะ มองเห็นผู้เล่นอื่น", Content = GetStatusText(Value)})

      task.spawn(function()
         while PlayerESPEnabled do
            task.wait(1)
            pcall(function()
               for _, player in pairs(game.Players:GetPlayers()) do
                  if player ~= game.Players.LocalPlayer and player.Character then
                     local char = player.Character
                     if not char:FindFirstChild("PlayerHighlightESP") then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "PlayerHighlightESP"
                        highlight.Adornee = char
                        highlight.Parent = char
                        highlight.FillColor = PlayerESPColor
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                     else
                        char.PlayerHighlightESP.FillColor = PlayerESPColor
                        char.PlayerHighlightESP.Enabled = PlayerESPEnabled
                     end
                  end
               end
            end)
         end
         -- ปิดการทำงานเมื่อปิด Toggle
         for _, player in pairs(game.Players:GetPlayers()) do
            if player.Character and player.Character:FindFirstChild("PlayerHighlightESP") then
               player.Character.PlayerHighlightESP.Enabled = false
            end
         end
      end)
   end,
})

VisualTab:CreateColorPicker({
    Name = "ปรับสีมองเห็นผู้เล่นอื่น",
    Color = Color3.fromRGB(0, 255, 0),
    Flag = "PlayerESPColorPicker",
    Callback = function(Value)
        PlayerESPColor = Value
        for _, player in pairs(game.Players:GetPlayers()) do
            if player.Character and player.Character:FindFirstChild("PlayerHighlightESP") then
                player.Character.PlayerHighlightESP.FillColor = PlayerESPColor
            end
        end
    end
})

