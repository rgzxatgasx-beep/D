})

MainTab:CreateToggle({
   Name = "ยิงซอมบี้อัตโนมัติ (Auto Shoot Zombie)",
   CurrentValue = false,
   Flag = "AutoShootToggle",
   Callback = function(Value)
      AutoShoot = Value
      ShootStatus:Set({Title = "สถานะ ยิงซอมบี้อัตโนมัติ", Content = GetStatusText(Value)})

      task.spawn(function()
         while AutoShoot do
            task.wait(0.1)
            pcall(function()
               for _, obj in pairs(workspace:GetChildren()) do
                  if obj:FindFirstChild("Humanoid") and obj.Name:find("Zombie") then
                     -- โค้ดยิงซอมบี้
                  end
               end
            end)
         end
      end)
   end,
})

MainTab:CreateSection("ระบบเก็บของ")

local CoinsStatus = MainTab:CreateParagraph({
   Title = "สถานะ เก็บเงินแดงอัตโนมัติ",
   Content = GetStatusText(false)
})

MainTab:CreateToggle({
   Name = "เก็บเงินแดงอัตโนมัติ (Auto Collect Red Coins)",
   CurrentValue = false,
   Flag = "AutoCoinsToggle",
   Callback = function(Value)
      AutoCollectCoins = Value
      CoinsStatus:Set({Title = "สถานะ เก็บเงินแดงอัตโนมัติ", Content = GetStatusText(Value)})

      task.spawn(function()
         while AutoCollectCoins do
            task.wait(0.3)
            pcall(function()
               local char = game.Players.LocalPlayer.Character
               if char and char:FindFirstChild("HumanoidRootPart") then
                  for _, item in pairs(workspace:GetDescendants()) do
                     if item.Name == "RedCoin" or item.Name == "RedMoney" then
                        if item:IsA("BasePart") then
                           firetouchinterest(char.HumanoidRootPart, item, 0)
                           firetouchinterest(char.HumanoidRootPart, item, 1)
                        end
                     end
                  end
               end
            end)
         end
      end)
   end,
})

