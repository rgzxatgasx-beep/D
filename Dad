PlayerTab:CreateSlider({
   Name = "กระโดดสูง (Jump Power)",
   Range = {50, 250},
   Increment = 5,
   Suffix = "Power",
   CurrentValue = 50,
   Flag = "JumpSlider",
   Callback = function(Value)
