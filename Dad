local InfJumpStatus = PlayerTab:CreateParagraph({
   Title = "สถานะ กระโดดไม่จำกัด",
   Content = GetStatusText(false)
})

PlayerTab:CreateToggle({
   Name = "กระโดดไม่จำกัด (Infinite Jump)",
   CurrentValue = false,
   Flag = "InfJumpToggle",
   Callback = function(Value)
      InfiniteJumpEnabled = Value
      InfJumpStatus:Set({Title = "สถานะ กระโดดไม่จำกัด", Content = GetStatusText(Value)})
   end,
})

-- ฟังก์ชันรองรับระบบกระโดดไม่จำกัด
game:GetService("UserInputService").JumpRequest:Connect(function()
   if InfiniteJumpEnabled then
      local char = game.Players.LocalPlayer.Character
      if char and char:FindFirstChildOfClass("Humanoid") then
         char:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
      end
   end
end)

local InvisStatus = PlayerTab:CreateParagraph({
   Title = "สถานะ หายตัว",
   Content = GetStatusText(false)
})

PlayerTab:CreateToggle({
   Name = "ระบบหายตัว (Invisibility)",
   CurrentValue = false,
   Flag = "InvisToggle",
   Callback = function(Value)
      Invisibility = Value
      InvisStatus:Set({Title = "สถานะ หายตัว", Content = GetStatusText(Value)})

      local char = game.Players.LocalPlayer.Character
      if char then
         for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
               if part.Name ~= "HumanoidRootPart" then
                  part.Transparency = Invisibility and 1 or 0
               end
            end
         end
      end
   end,
})

